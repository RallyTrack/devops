# RallyTrack Pi 배포 시크릿 — 실제 값을 채워 .env로 저장 (gitignore 대상)
# 시크릿 생성 예: openssl rand -hex 32

# 네트워크
PI_LAN_IP=192.168.219.156
ML_SERVER_LAN_IP=192.168.219.150

# presigned URL 서명 주소 = 브라우저·AI서버가 실제로 여는 주소
# 공개 도메인(Cloudflare Tunnel) 사용 시 https://app.rallytrack.win
# LAN 전용으로 되돌리려면 http://<PI_LAN_IP>:9000
S3_PUBLIC_ENDPOINT=https://app.rallytrack.win
CORS_ALLOWED_ORIGINS=https://app.rallytrack.win,http://192.168.219.156:8082,http://localhost:5173

# DB
DB_ROOT_PASSWORD=change-me
DB_PASSWORD=change-me

# MinIO (backend의 S3 자격증명으로도 사용됨)
MINIO_ROOT_USER=rallytrack-admin
MINIO_ROOT_PASSWORD=change-me

# JWT (32바이트 이상 필수 — HS256)
JWT_SECRET=change-me-at-least-32-bytes-long

# AI 서버 콜백 공유 시크릿 (ml-server systemd 유닛의 값과 동일해야 함)
ANALYSIS_CALLBACK_SECRET=change-me

# Slack Incoming Webhook (rally-track-back-log 채널, 비우면 알림 비활성)
SLACK_BACK_WEBHOOK=

# 최초 배포 시에만 update로 설정해 테이블 생성 후 validate로 되돌릴 것
DDL_AUTO=validate
